{
  "name": "@ido-bata/ae-a8n",
  "version": "0.4.0",
  "description": "Drive Adobe After Effects from Node: open projects, apply effects, set parameters, render frames. Local automation is verified on real hosts (macOS AE 26.5/27 and Windows AE 2027); the opt-in in-AE dispatcher and isolated backend are experimental with partial real-host evidence.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ido-bata/ae-a8n.git"
  },
  "homepage": "https://github.com/ido-bata/ae-a8n#readme",
  "bugs": {
    "url": "https://github.com/ido-bata/ae-a8n/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": false
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ae-a8n": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "host",
    "skills",
    "examples/*.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json",
    "lint": "eslint src test examples scripts --no-error-on-unmatched-pattern",
    "test": "vitest run && node scripts/run-isolated-session-checks.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sync:consent-vectors": "node scripts/sync-consent-vectors.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "after-effects",
    "adobe",
    "extendscript",
    "automation",
    "testing",
    "jsx"
  ],
  "dependencies": {
    "acorn": "^8.18.0"
  }
}
