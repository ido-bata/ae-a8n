{
  "name": "@ido-bata/ae-a8n",
  "version": "0.1.0-alpha.1",
  "description": "Drive Adobe After Effects from Node: open projects, apply effects, set parameters, render frames. macOS-verified alpha.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ido-bata/ae-a8n.git"
  },
  "homepage": "https://github.com/ido-bata/ae-a8n#readme",
  "bugs": {
    "url": "https://github.com/ido-bata/ae-a8n/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": false
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "host",
    "skills",
    "examples/*.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json",
    "lint": "eslint src test examples --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "acorn": "^8.18.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "after-effects",
    "adobe",
    "extendscript",
    "automation",
    "testing",
    "jsx"
  ]
}
